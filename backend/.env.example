# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ielts_practice

# JWT
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_MINUTES=1440

# Poe API (OpenAI-compatible)
POE_API_KEY=your-poe-api-key-here
POE_MODEL=gpt-5.4-nano

# Resend email API (https://resend.com) — recommended, delivers to any email address
RESEND_API_KEY=your-resend-api-key-here
# Gmail SMTP (fallback) — only works reliably for Gmail-to-Gmail delivery
GMAIL_APP_PASSWORD=your-16-char-gmail-app-password
EMAIL_FROM=IELTS Practice <onboarding@resend.dev>
